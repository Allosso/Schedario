# Testi con fine riga normalizzata; gli script per Linux e macOS sempre con LF
# (con CRLF la shell non li esegue), quelli per Windows con CRLF.
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf

# File binari: mai toccati.
*.ttf binary
*.png binary
*.ico binary
*.so binary
*.jar binary
